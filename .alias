# general

alias c='clear'
alias reload='source  ~/.zshrc'
alias dotfiles:alias='vim ~/dotfiles/.alias'

# git
alias gs='git status'
alias gaa='git add .'
alias gcm='git commit -m '


# laravel

alias sail='./vendor/bin/sail'



# directory navigation

alias goto:code:fledermaus='cd ~/code/php/fledermaus-at'


# directory projects

## fledermaus-at
alias project:code:fledermaus-at='cd ~/code/php/fledermaus-at'
alias project:documents:fledermaus-at='cd ~/documents/projects/fledermaus-at'

## starkbaum-me
alias project:code:starkbaum-me='cd ~/code/php/starkbaum-me'
